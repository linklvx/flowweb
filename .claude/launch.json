{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "turbo",
        "run",
        "dev",
        "--filter=@flowweb/web"
      ],
      "port": 5173,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "turbo",
        "run",
        "dev",
        "--filter=@flowweb/api"
      ],
      "port": 3000,
      "cwd": "${workspaceFolder}",
      "env": {
        "COLLAB_PORT": "3001"
      }
    },
    {
      "name": "minio",
      "runtimeExecutable": "minio.exe",
      "runtimeArgs": [
        "server",
        "./flowweb.data/minio",
        "--console-address",
        ":9001"
      ],
      "port": 9000,
      "cwd": "${workspaceFolder}",
      "env": {
        "MINIO_ROOT_USER": "minioadmin",
        "MINIO_ROOT_PASSWORD": "minioadmin"
      }
    }
  ],
  "compounds": [
    {
      "name": "All Services",
      "configurations": [
        "minio",
        "api",
        "web"
      ]
    }
  ]
}
