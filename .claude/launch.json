{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "turbo",
        "run",
        "dev",
        "--filter=@flowweb/web"
      ],
      "port": 5173,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "turbo",
        "run",
        "dev",
        "--filter=@flowweb/api"
      ],
      "port": 3000,
      "cwd": "${workspaceFolder}",
      "env": {
        "COLLAB_PORT": "3001"
      }
    },
    {
      "name": "api-b (handover only——同机第二实例只能错端口跑，且只有先起的那个能持有 collab；N15：3000/3001 端口冲突先于租约，租约价值=TTL 崩溃接管/跨主机/误配快速失败)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "turbo",
        "run",
        "dev",
        "--filter=@flowweb/api"
      ],
      "port": 3002,
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3002",
        "COLLAB_PORT": "3003"
      }
    },
    {
      "name": "web-b",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5174"
      ],
      "port": 5174,
      "cwd": "${workspaceFolder}/apps/web"
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@flowweb/web",
        "exec",
        "vite",
        "preview",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "minio",
      "runtimeExecutable": "minio.exe",
      "runtimeArgs": [
        "server",
        "./flowweb.data/minio",
        "--console-address",
        ":9001"
      ],
      "port": 9000,
      "cwd": "${workspaceFolder}",
      "env": {
        "MINIO_ROOT_USER": "minioadmin",
        "MINIO_ROOT_PASSWORD": "minioadmin"
      }
    }
  ],
  "compounds": [
    {
      "name": "All Services",
      "configurations": [
        "minio",
        "api",
        "web"
      ]
    }
  ]
}
