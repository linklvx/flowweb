{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["turbo", "run", "dev", "--filter=@flowweb/web"],
      "port": 5173,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "api",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["turbo", "run", "dev", "--filter=@flowweb/api"],
      "port": 3000,
      "cwd": "${workspaceFolder}"
    }
  ]
}
