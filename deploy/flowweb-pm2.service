# deploy/flowweb-pm2.service —— FlowWeb 双进程 pm2-runtime 前台托管 unit（Y0c T31：Z115 P3 形态+Z85 数字）
# 安装=runbook §1.1 手动步骤（一次性 sudo 高危操作，deploy.sh 不自动化 systemctl——RB5）；
# 本文件不进 deploy.sh 上传面（手动 scp——§0.6 偏离 43）。
#
# 前台模式（Z115 P3）：pm2-runtime 不 daemonize——Type=simple，无需 PIDFile/forking 形态；
# 日志直进 journal（journalctl -u flowweb-pm2 -f）。User/PM2_HOME 显式对齐运行用户，
# 防第二 god（root 的 pm2 daemon 与 ubuntu 的互不可见——systemctl/pm2 操作落空面）。
#
# 分层防线（Z85 写死——runbook §1.1 同源，三层各管各的）：
#   第一层 per-process = PM2 max_memory_restart（ecosystem 现 1G×2，T32 校准 560/480）
#                        ——单进程泄漏→只重启该 app
#   机器兜底           = 本 unit cgroup MemoryMax=1150M（算式 560+480+god 40.4+余量 70）
#                        ——总量超限→内核杀 RSS 最大者（=泄漏者），pm2 autorestart 拉起=设计行为；
#                        MemorySwapMax=128M：宁被杀不换页（换页拖垮协居 PG/Redis/MinIO）
#   unit 级故障        = Restart=on-failure+RestartSec=5（god 崩溃面——pm2 autorestart 管不了自己）
#
# 方案 B（删 PM2，systemd 模板单元直管双进程）登记 Y7 评估（Z115）——pm2-runtime 是过渡托管层非终态。

[Unit]
Description=FlowWeb pm2-runtime (flowweb-api + flowweb-worker)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment=PM2_HOME=/home/ubuntu/.pm2
ExecStart=/usr/bin/pm2-runtime start /home/ubuntu/flowweb/ecosystem.config.cjs
Restart=on-failure
RestartSec=5
MemoryMax=1150M
MemorySwapMax=128M

[Install]
WantedBy=multi-user.target
