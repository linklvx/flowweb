g5-t22-delivery-int|cd apps/api && npx vitest run -c vitest.int.config.ts src/modules/collab/collab-t22-delivery-switch.int.spec.ts
g5-t22-feed-int|cd apps/api && npx vitest run -c vitest.int.config.ts src/modules/collab/runtime-feed.t22-g5.int.spec.ts
g5-c14-poller-convergence|cd apps/api && npx vitest run -c vitest.int.config.ts src/modules/media-delivery/projection-outbox.poller.int.spec.ts src/modules/collab/collab-harness/provider-convergence.e2e-spec.ts
g6a-t13-g6a-int|cd apps/api && npx vitest run -c vitest.int.config.ts src/modules/collab/collab-t13-g6a.int.spec.ts
