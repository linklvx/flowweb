# 完整键集单源=apps/api/src/config/env.ts（zod schema）；服务器真值在 apps/api/.env（chmod 600）
# 本文件是契约清单（对新人可见），不是可运行真值——键名/类型/必填性以 env.ts 为准。
# 空串=未设（B13）：zod 经 blankToUnset 把 '' 按未设走 optional/default，清开关写空值安全。
# 本文件注释一律独立成行、键行裸写——服务器 .env 同样禁 export 前缀与行内注释（shell 工具直读前提）。

# ── zod 必填 5 键（无默认，缺=启动拒）──────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/flowweb
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=changeme-key
# min 3 字符
MINIO_SECRET_KEY=changeme-secret
# min 8 字符

# ── 有默认但显式列出 ────────────────────────────────────────────
PORT=3000
REDIS_URL=redis://localhost:6379/0
CORS_ORIGIN=http://localhost:5173
MINIO_BUCKET=flowai

# ── MINIO_USE_SSL：normalize 语义（非 coerce.boolean）────────────
# 小写化后 ==='true' 才 true；其余一切值（'false'/大小写混杂/空/未设）=false——
# 消灭 Boolean('false')===true 反相，且任意串过验不拒启动。
MINIO_USE_SSL=false

# ── WeChat Pay API v3（optional，默认空——仅充值功能需要）─────────
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_MERCHANT_CERT=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=

# ── WeChat 网站扫码登录（optional，默认空）───────────────────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_LOGIN_REDIRECT_URI=

# ── 可观测（optional，无默认）──────────────────────────────────
# SENTRY_DSN=
# PROMETHEUS_TOKEN=
# PROMETHEUS_TOKEN：/metrics 令牌，同时是 ready 授权档双令牌之一（drain 不认它——W23）

# ── 部署姿态（schema 外，process.env 直读）──────────────────────
NODE_ENV=production
# 八读点影响面（cookie Secure/FAKE_AI/prom fail-closed/admin-guard/debounce 档位/Sentry 等）
# ——审计归 Y0.5/E58；现值语义见 docs/superpowers/collab-ops-runbook.md §8

# ── COLLAB 协作族 + COMPACT_INTERVAL_MS（全 optional——默认值唯一定义在消费点，
#    此处不设即走默认；设值请连注释一起读）────────────────────────
# WS 监听端口，默认 3001
COLLAB_PORT=3001
# 写防抖 ms——双档 dev 1000/其余 2000；显式设值会压平双档，留空保持
# COLLAB_DEBOUNCE=
# 客户端不活跃判定 ms，默认 30000
COLLAB_TIMEOUT=30000
# Yjs 更新压缩间隔 ms，默认 60000——真实键名无 COLLAB_ 前缀（前缀统一登记 Y0c env 根修）
COMPACT_INTERVAL_MS=60000
# spool 清扫开关——仅字符串 'true' 启用，其余（'false'/空/未设）=关
# COLLAB_SWEEP_ENABLED=
# spool 账本目录——默认 CWD 下 .data/collab-spool；显式相对路径启动即抛（绝对路径强制）。
# 生产用绝对路径且部署树外，ecosystem.config.cjs 已注入下行值：
# COLLAB_SPOOL_DIR=/home/ubuntu/flowweb-data/collab-spool
# spool 容量上限字节，默认 256MB
# COLLAB_SPOOL_CAPACITY_BYTES=
# 租约 TTL ms，默认 10000
COLLAB_LEASE_TTL_MS=10000
# 租约心跳 ms，默认 3000——不变式 0<心跳≤TTL/2，违者启动拒
COLLAB_LEASE_HEARTBEAT_MS=3000
# drain 唯一凭据（W23：无 PROMETHEUS_TOKEN 回退；生产无令牌=403 fail-closed）。
# 首次部署前必须在服务器 .env 设值（openssl rand -hex 32），缺失则 guard pre 段必失败
# COLLAB_ADMIN_TOKEN=
# 常驻 doc 上限——spec §3 4.6:502 点名预留，仅解析零消费（enforcement 归 Y1c-3）
# COLLAB_MAX_LOADED_DOCS=
# WS 绑定面——默认 0.0.0.0；生产由 ecosystem 注入 127.0.0.1（3001 不公网监听，nginx 同机反代唯一路径）
# COLLAB_BIND_ADDR=

# 腾讯云 SMS
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_SIGN_NAME=

# 限流白名单（逗号分隔，支持CIDR网段 /8、/16、/24）
RATE_LIMIT_IP_WHITELIST=127.0.0.1,::1
