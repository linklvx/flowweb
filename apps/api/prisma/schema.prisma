datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  strict   = true
}

enum Role {
  USER
  ADMIN
}

model User {
  id                      String             @id
  name                    String
  email                   String             @unique
  emailVerified           Boolean
  role                    Role               @default(USER)
  image                   String?
  phoneNumber             String?            @unique @db.VarChar(20)
  phoneNumberVerified     Boolean            @default(false)
  wechatOpenid            String?            @unique @db.VarChar(64)
  wechatUnionid           String?            @db.VarChar(64)
  createdAt               DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @db.Timestamptz(3)
  accounts                Account[]
  sessions                Session[]
  templates               Template[]
  canvasProjects          CanvasProject[]
  media                   Media[]
  materialFolders         MaterialFolder[]
  folders                 Folder[]
  teamsOwned              Team[]
  teamMemberships         TeamMember[]
  teamJoinRequests        TeamJoinRequest[]
  decidedTeamJoinRequests TeamJoinRequest[]  @relation("TeamJoinRequestDecidedBy")
  projectMembers          ProjectMember[]
  videoProjects           VideoProject[]
  styleFavorites          StyleFavorite[]
  styleRecentUsages       StyleRecentUsage[]
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model Announcement {
  id        String   @id @default(cuid())
  message   String   @db.VarChar(200)
  linkText  String?  @db.VarChar(32)
  linkUrl   String?  @db.VarChar(500)
  bgColor   String   @default("#0f2761") @db.VarChar(16)
  textColor String   @default("#ffffff") @db.VarChar(16)
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model ContentCard {
  id        String   @id @default(cuid())
  title     String
  coverUrl  String
  tags      String[]
  desc      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([active, sortOrder])
}

model HomeBanner {
  id        String   @id @default(cuid())
  title     String?  @db.VarChar(128)
  subtitle  String?  @db.VarChar(256)
  linkUrl   String?  @db.VarChar(500)
  imageKey  String   @db.VarChar(255)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([active, sortOrder])
}

model Template {
  id        String         @id @default(cuid())
  name      String
  folderId  String?
  folder    Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  projectId String?        @unique
  project   CanvasProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId    String
  teamId    String?
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([userId])
  @@index([teamId])
}

model CanvasProject {
  id             String              @id @default(cuid())
  name           String
  userId         String?
  teamId         String
  // C1-0（R15/R17 生产就绪收尾批）：lifecycleState=持久 fence 判据列（ACTIVE|DELETING——非 ACTIVE
  // 写路径拒绝〔fenceProject FOR SHARE 行锁读〕；状态机接线/HTTP 映射归 C4）+origin=谱系列
  // （值域单源 shared CANVAS_PROJECT_ORIGINS=['user','clone']——governance 单源写点〔C2-0 两创建
  // 路径均 'user'〕；'clone' 谱系 video-work clone 接线+cleanDrafts 谓词消费，C4 接线）。
  lifecycleState String              @default("ACTIVE")
  origin         String?
  templates      Template[]
  canvasDoc      CanvasDoc?
  docSnapshots   CanvasDocSnapshot[] // Y1c T7：载体族快照反向关系（双侧全补）
  projectMembers ProjectMember[]
  docUpdates     CanvasDocUpdate[]
  videoProjects  VideoProject[]
  // C1-1（v5.2 终态）：MediaBinding.projectId FK Cascade 反向关系——项目删除零残留
  mediaBindings  MediaBinding[]
  // C3b-1（spec §3.4-2/v5.2 ⑧）：oracle 双表 project FK Cascade 反向关系——项目删除零残留
  referenceOracles    CanvasReferenceOracle[]
  referenceOracleScan CanvasReferenceOracleScan?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamId])
  @@index([lifecycleState]) // C1-0：擦除扫（非 ACTIVE 活跃擦除行集）
}

model Folder {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  parentId  String?
  userId    String
  teamId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  parent    Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]   @relation("FolderHierarchy")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  templates Template[]

  @@index([teamId])
}

model NodeType {
  id           String        @id @default(cuid())
  name         String
  key          String        @unique
  description  String?
  active       Boolean       @default(true)
  models       AIModel[]
  pricingRules PricingRule[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
}

model AIModel {
  id            String            @id @default(cuid())
  nodeTypeId    String
  nodeType      NodeType          @relation(fields: [nodeTypeId], references: [id], onDelete: Cascade)
  name          String
  provider      String // Y0b-2 裁定 5：slug（moonshot/tencent/stability/openai）——显示名移 providerLabel
  apiUrl        String
  apiKey        String?
  apiModelName  String? // provider 侧模型 id（active 行断言非空——外呼真名）
  providerLabel String? // 显示名（原 provider 列内容）
  sortOrder     Int               @default(0)
  recommended   Boolean           @default(false)
  active        Boolean           @default(true)
  resolutions   ModelResolution[]
  durations     ModelDuration[]
  pricingRules  PricingRule[]
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  @@index([nodeTypeId, active])
  @@index([nodeTypeId, sortOrder])
}

model ModelResolution {
  id           String        @id @default(cuid())
  modelId      String
  model        AIModel       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  label        String
  width        Int
  height       Int
  pricingRules PricingRule[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([modelId])
}

model ModelDuration {
  id           String        @id @default(cuid())
  modelId      String
  model        AIModel       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  label        String
  seconds      Int
  pricingRules PricingRule[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([modelId])
}

model PricingRule {
  id           String           @id @default(cuid())
  nodeTypeId   String
  nodeType     NodeType         @relation(fields: [nodeTypeId], references: [id], onDelete: Cascade)
  modelId      String?
  model        AIModel?         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  resolutionId String?
  resolution   ModelResolution? @relation(fields: [resolutionId], references: [id])
  durationId   String?
  duration     ModelDuration?   @relation(fields: [durationId], references: [id])
  creditCost   Int
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  intentSnapshots GenerationIntent[] // Y0b-1：claim 定价快照反向关系（快照 FK SET NULL——规则行删除时快照仍存活）

  @@index([nodeTypeId])
  @@index([modelId])
}

model Media {
  id     String @id @default(uuid())
  userId String

  // 存储信息
  bucket       String @default("flowai")
  key          String // MinIO 对象键
  originalName String // 原始文件名
  mimeType     String
  // Y1b T2 质评收口（Important-1）：Int 2.147GB 上限根修（v10 裁决/spec Z7'' :80/M1 门）——
  // BigInt；JSON 序列化由 T6 收紧裁决执行：禁全局 BigInt.prototype.toJSON——DTO/响应构造处显式转换
  //（size→Number 展示口径；material/media-batch 响应面已收口，T6 序列化测试覆盖）
  size         BigInt // 字节数

  // 业务关联
  projectId String?
  nodeId    String?
  taskId    String?

  // 状态与类型
  status   MediaStatus @default(pending) // Y1b T2：String→enum（processing=stage/video 未 materialize；failed=终态失败补偿退款）
  type     String // uploaded | generated | temp
  metadata Json? // 扩展元数据（ffprobe信息、血缘sourceFileId/bizType等）

  // Y1b T2（Z1''/Z7''）：sourceUrl 专用列（provider 源禁入 metadata——整行 spread 泄漏；加密是应用层）
  sourceUrl             String?
  sourceUrlExpiresAt    DateTime?  @db.Timestamptz(3) // 源过期判定（过期→materialize 重试判据）
  // materialize 族（video 异步物化——自有 lease/attempts 与 intent attempts/rearm 解耦）
  processingLeaseUntil  DateTime?  @db.Timestamptz(3)
  processingAttempts    Int        @default(0)
  nextMaterializeAt     DateTime?  @db.Timestamptz(3)
  // probe 族（上传路径 worker 重计算）——裁定3 完整化：v10.1 plan Task 3 Media 块八列全量
  // （docs/superpowers/plans/2026-10-18-y1a-y1b-doc-model-order-size.md@5c24441c :86-93；未落地六列本批补齐，
  //  optional/带默认——消费卡 T4/T7 零迁移可用）
  probeState            ProbeState @default(pending) // confirm 后按 sniffed 重算（v10.1 :86）
  probeAttempts         Int        @default(0) // v10.1 :87
  probeError            String?    @db.VarChar(512) // v10.1 :88
  probeFailureKind      String? // v10.1 :89
  probeLeaseUntil       DateTime?  @db.Timestamptz(3) // v10.1 :90
  probeRunId            String? // v10.1 :91
  nextProbeAt           DateTime?  @db.Timestamptz(3) // jitter 退避（v10.1 :92）
  probedAt              DateTime?  @db.Timestamptz(3) // 仅审计（v10.1 :93）
  factVersion           BigInt     @default(0) // 单调事实版本（每次 natural/sniff/status 变更+1）；wire/doc 用 string（v8 裁决②）——JSON 序列化=T6 收紧：DTO/响应构造处显式 String()（禁全局 BigInt.prototype.toJSON）
  // natural/sniffed 族（v10.1 plan Task 3 Media 块 :94-97——质评 Important-1 补齐）：server fact 消费
  // （probe done/server natural 同事务 factVersion+1+outbox）；sniffedMimeType=probe claim 路由
  // （spec Z7'' :80 按 sniffed image/video 非 SVG）+content 端点 Content-Type 源
  naturalWidth          Int? // display
  naturalHeight         Int?
  naturalRotation       Int? // 血缘
  naturalSource         String?
  sniffedMimeType       String?
  // v11 pending 上传 TTL+presign 幂等键
  pendingExpiresAt      DateTime?  @db.Timestamptz(3)
  clientUploadId        String?
  sourceRegistrationKey String? // 非资金幂等锚（nullable——非资金路径 registrationKey）
  // origin/审计锚（plan v11.2 T2：资金唯一键 [sourceIntentRowId,sourceExecSeq,artifactIndex] 移
  // NodeArtifact——Media 侧三列保留为 origin/审计；stageInTx durable 化落行字段 v10.1 头注③）
  sourceIntentRowId     String? // 资金型锚（=GenerationIntent.id）——有 artifact 的 intent 不物理删（7d 悬空锚根修）
  sourceExecSeq         BigInt? // 代际
  artifactIndex         Int        @default(0)
  // 对象幂等/hash 校验（stageInTx 落行：objectKey/sha256——v10.1 :102）
  objectKey             String?
  objectSha256          String?

  // 时间戳
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime? @db.Timestamptz(3) // 临时文件过期时间

  // 素材库关联
  folderId      String? // 关联素材库文件夹
  isFavorite    Boolean   @default(false) // 收藏标记
  thumbnailKey  String? // 缩略图对象键（URL动态生成，避免过期）
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3) // 软删除
  // C3a-2（spec §0 C3b/§3.2-6）：删除事务态 ACTIVE|DELETING——DELETING=删除事务进行中（doc 帧照写
  // binding=recheck 证人，「引用即中止删除」；列本卡落位解 C1 前引用冲突，**消费归 C3b-4**）。
  // DB CHECK IN ('ACTIVE','DELETING') 为 raw 迁移附（Prisma 不可表达——MediaFact.factType 同款先例）。
  deletionState String    @default("ACTIVE")
  // C3b-4（spec §3.4-5 :81）：DELETING 状态机审计三列——CAS 抢占（ACTIVE→DELETING）时落值；
  // 回退 ACTIVE 保留值=最近一次删除尝试的审计痕迹（runbook §13.2——ACTIVE∧非空=上次尝试中止/失败）。
  deletionRequestedAt DateTime? @db.Timestamptz(3)
  deletionRunId       String?
  deletionReason      String?

  folder MaterialFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  facts MediaFact[] // C2：当前态事实行（替代推送式 outbox——写点改道归 C2-2）

  @@unique([bucket, key]) // 对象级幂等（v11）
  @@unique([teamId, clientUploadId]) // presign 幂等键（nullable 复合——PG NULL 不冲突）
  @@unique([sourceRegistrationKey]) // 非资金幂等（nullable）
  @@index([userId])
  @@index([teamId])
  @@index([projectId])
  @@index([nodeId])
  @@index([taskId])
  @@index([expiresAt])
  @@index([userId, folderId, createdAt])
  @@index([userId, isFavorite])
  @@index([type, status, deletedAt])
  @@index([status, nextMaterializeAt]) // materialize claim（v11）
  @@index([probeState, nextProbeAt]) // probe claim（v11）
  @@index([status, pendingExpiresAt]) // pending TTL 清理（v11）
}

// 素材文件夹表
model MaterialFolder {
  id        String    @id @default(cuid())
  name      String
  parentId  String?
  userId    String
  teamId    String
  sortOrder Int       @default(0)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  parent   MaterialFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children MaterialFolder[] @relation("FolderHierarchy")
  files    Media[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId, sortOrder])
  @@index([userId, deletedAt])
}

model LightingTask {
  id               String             @id @default(uuid())
  userId           String
  nodeId           String
  projectId        String?
  originalImageUrl String             @db.VarChar(512)
  resultImageUrl   String?            @db.VarChar(512)
  resultMediaId    String?
  params           Json
  status           LightingTaskStatus @default(pending)
  costCredits      Int                @default(0)
  errorMessage     String?            @db.Text
  teamId           String
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?          @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamId])
  @@index([status])
}

enum LightingTaskStatus {
  pending
  processing
  success
  failed
}

model VideoTrimTask {
  id           String    @id @default(cuid())
  userId       String
  workflowId   String
  nodeId       String
  sourceFileId String
  startTime    Float
  endTime      Float
  status       String    @default("queued")
  outputFileId String?
  errorMsg     String?
  teamId       String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime? @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@index([userId])
  @@index([teamId])
}

model VideoSeparateTask {
  id           String    @id @default(cuid())
  userId       String
  workflowId   String
  nodeId       String
  sourceFileId String
  mode         String    @default("split")
  status       String    @default("queued")
  videoFileId  String?
  audioFileId  String?
  errorMsg     String?
  errorType    String?
  teamId       String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime? @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@index([userId])
  @@index([teamId])
  @@index([sourceFileId])
}

model VideoProject {
  id           String   @id @default(cuid())
  teamId       String
  userId       String // 取当前操作用户（assertEditor 通过者）——与 CanvasProject.userId 可空无关
  workflowId   String // CanvasProject.id：regenerate/socket room/资产过滤/级联删除
  sourceNodeId String   @unique // 视频剪辑节点自身 nodeId——一剪辑节点一工程
  title        String
  data         Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  team     Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow CanvasProject @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId])
  @@index([workflowId])
}

// ========== 会员订阅 ==========

enum SubscriptionTier {
  basic
  pro
  max
  ultra
}

enum SubscriptionPeriod {
  monthly
  quarterly
  annually
}

enum SubscriptionStatus {
  active
  expired
  upgraded
}

enum SubscriptionOrderType {
  new_purchase
  upgrade
  renewal
}

enum SubscriptionOrderStatus {
  PENDING
  SUCCESS
  FAILED
  CLOSED
}

enum CreditType {
  regular
  subscription
}

enum AuditTargetType {
  subscription
  subscription_plan
  point
  order
  TEAM
  TEAM_MEMBER
  PROJECT
  PROJECT_MEMBER
  COLLAB_LEASE // Y0a-3：break-glass/drain 审计行（targetId=scope 'primary'）
}

model SubscriptionPlan {
  id                     String             @id @default(cuid())
  name                   String
  tier                   SubscriptionTier
  monthlyCredits         Int
  storageLimitBytes      BigInt
  priceMonthly           Int
  originalPriceMonthly   Int                @default(0)
  priceQuarterly         Int
  originalPriceQuarterly Int                @default(0)
  priceAnnually          Int
  originalPriceAnnually  Int                @default(0)
  sort                   Int                @default(0)
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)
  subscriptions          UserSubscription[]

  @@index([isActive, sort])
}

model SubscriptionBanner {
  id                 String    @id @default("subscription-banner-singleton")
  /// Banner 标题文字，最多64字符
  title              String    @db.VarChar(64)
  /// Banner 副标题/描述文字，最多200字符
  subtitle           String    @db.VarChar(200)
  /// 外部图片URL，优先使用已上传图片
  backgroundImageUrl String?   @db.VarChar(500)
  /// MinIO 对象存储 Key，优先级高于外部URL
  backgroundImageKey String?   @db.VarChar(255)
  /// 倒计时截止时间，UTC存储；为空则不展示倒计时
  countdownEndAt     DateTime? @db.Timestamptz(3)
  /// 倒计时归零后自动顺延3天，仅countdownEndAt非空时生效
  autoExtend         Boolean   @default(false)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  @@map("subscription_banner")
}

model UserSubscription {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  tier               SubscriptionTier
  period             SubscriptionPeriod
