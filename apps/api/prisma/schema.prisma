/// 会话恢复 spec v5.10 B1/F1/F13——幂等与在飞互斥载体（净删 SETNX/dedup/五段键/失败重放计数）
model GenerationIntent {
  id                   String       @id @default(cuid())
  projectId            String
  nodeId               String
  userId               String // F13：退款回滚 monthlyUsed 需归因到人；对账三面 join 键
  teamId               String // Y0b-1（Z4/E1）：无 FK 纯列（契约 14——Restrict 与物理删不兼容；资金路径直查锚）
  intentId             String // 客户端 runId——与 projectId 复合唯一（F1：跨项目撞键=两行独立不误伤）
  kind                 String // text|video|image|outpaint|erase|redraw|lighting
  paramsHash           String // 服务端规范化哈希——命中比对谓词（防客户端改参复用 intentId）
  status               IntentStatus @default(RUNNING)
  jobId                String? // 同步路径为空——reconcile 三查特判（F13）
  pricingRuleId        String? // 定价快照（FK SET NULL——规则行删除时快照仍可空存活）
  pricingRule          PricingRule? @relation(fields: [pricingRuleId], references: [id])
  modelId              String?
  resolutionId         String?
  durationId           String?
  creditCost           Int // NOT NULL——claim 无条件固化（creditCost:0 也固化——E1/A2）
  creditsConsumed      Int          @default(0) // F13：扣费时即写（consume 事务内 CAS）——崩溃窗口对账可判；退款事务归零
  reservedCredits      Int          @default(0) // 批0.5-9 reserve 冻结载体列（约束①：不用 PENDING 状态）——reserve 事务内置位/settle 清零/void 清零，CAS 锚防 stalled 重入双冻结
  attempts             Int          @default(1) // F13 补强：免费重放上限——rearm 自增，≥3 拒绝再激活
  resultRef            String? // Media id / 产物 URL
  error                String?
  // Y0b-2 T1（Z68/Z83/Z82）：心跳/deadline/外呼起点——无 DB 默认（服务端写入单源）
  heartbeatAt          DateTime // claim/reaper 心跳锚（RUNNING 生命线）
  deadlineAt           DateTime // 外呼硬截止（分 kind 常量表 env 注入）
  startedAt            DateTime? // 外呼真正开始（phase 判据——Z83）
  idemKey              String       @unique // Z82：内容+手势幂等键（deriveIdemKey 单源 sha256）——claim 唯一判据
  gestureKey           String? // Z79：手势 token 审计列（客户端原始入参截断落库——nullable）
  traceId              String? // Y0b-5 T13：W3C trace-id（x-request-id 同源，服务端生成）——组执行资金审计锚（一次请求=N 行同 traceId）
  providerTaskId       String? // Z69：submit 后落库（外呼 provider 任务 id）
  // Y1b T2（Z18''-v13b）：execSeq 全局单调执行代际（DB sequence "exec_seq" nextval 两处：new claim/rearm——
  // wire/doc 用 string）+reserve/settle/void CAS 维度+error 投影代际。
  // 裁定2：@default(nextval)=兜底默认（消解存量 createMany 缺列的 tsc 必填）——T8/T9 claim/rearm
  // 仍事务内显式取号，默认不参与代际契约（显式赋值覆盖默认，行为等价）。
  // 注：migrate diff 将迁移侧 nextval 默认 introspect 为 Sequence("exec_seq")、datamodel 侧为
  // DbGenerated——Prisma 5.22 无 sequence() 属性不可对齐，该漂移行按裁定2 先例登记金标（同 pricing_rule）
  execSeq              BigInt       @unique @default(dbgenerated("nextval('exec_seq')"))
  reservedExecSeq      BigInt? // reserve 时写；settle/void CAS 匹配（旧代一律失败）
  execProjectedExecSeq BigInt? // exec error 投影代际（reconcile 判据）
  resultText           String?      @db.Text // text kind 产物正文（90 天保留——非空行延长）
  providerRequestId    String? // v13b write-ahead：submit 前落库（Idempotency-Key——消灭 submit→DB 崩溃窗）
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  completedAt          DateTime?

  @@unique([projectId, intentId]) // Z88 保留：exec 投影对齐的零成本保险（行身份列——claim 判据已改 idemKey）
  @@index([projectId, nodeId, status])
  @@index([projectId, nodeId, status, createdAt]) // Z114：claim ② 跨状态判据复合——普通索引可表达进 datamodel
  @@index([teamId]) // 资金路径（生命周期门/对账）直查
  @@index([jobId]) // F13：reconcile 活跃核验按 jobId 查 BullMQ 状态
  @@index([traceId]) // Y0b-5 T13：审计读面"该 trace 下所有 intent"（普通索引——唯一索引会与 skipDuplicates 冲突静默丢行+否定审计用途）
  // Y0b-2 Z114②：@@index([status, updatedAt]) 删除（reaper 判据改 deadlineAt/heartbeatAt 两条 partial——
  // running_deadline_idx/running_heartbeat_idx 保持 migration-SQL-only 不进 Prisma 声明，partial 零棘轮成本）
  @@index([status, completedAt]) // 保留策略清理扫描用（终态 N 天清理——F1）
  @@index([status, execProjectedExecSeq]) // Y1b T2：exec error reconcile 判据
  @@index([providerTaskId]) // Y1b T2：query-first 键序 requestId→taskId 重呼
}

enum IntentStatus {
  RUNNING // claim 直建 RUNNING——PENDING 删除（F13 补强：无写者的死枚举值）
  SUCCEEDED
  FAILED
  VOIDED
}

// ========== Y1a+Y1b T2：产物权威/投影交付/引用索引/媒体事实 ==========

// v11：生成产物状态（video finalize=materializing→materialize 成功 stored；终态失败 failed）
enum ArtifactState {
  none
  materializing
  stored
  failed
}

// v10.1：Media.status String→enum（processing=stage/video 未 materialize；failed=终态失败补偿退款）
enum MediaStatus {
  pending
  processing
  completed
  failed
}

// v10.1 词表：probe 单相状态机（claim IN(pending,running∧lease 过期)；MaterializeJob 完成置 done）
enum ProbeState {
  pending
  running
  done
  failed
  skipped
}

// v11：DocDelivery→ArtifactProjection 六终态（projected 仅来自 projecting；orphaned/superseded/dead 终态不可回退——状态机归 T15）
enum ProjectionState {
  pending
  projecting
  projected
  orphaned
  superseded
  dead
}

// v11：MediaFactOutbox 投递状态（pending→published/dead；published retention 7d）
enum MediaFactState {
  pending
  published
  dead
}

/// v11 新建——生成产物唯一权威（PG；doc fileId/result 的唯一写入源经投影）。
/// 权威=(sourceIntentRowId, execSeq, rev)；槽位唯一（role/targetField/targetItemId）；rev=finalize/replace/clear CAS 锚。
model NodeArtifact {
  id                String        @id @default(cuid())
  projectId         String
  nodeId            String
  teamId            String
  role              String        @default("primary") // CHECK 白名单（raw SQL——词表 primary）
  targetField       String // fileId | result —— CHECK 白名单（raw SQL）
  targetItemId      String        @default("") // 非空 sentinel；本批一 intent 一 artifact 默认 ''
  mediaId           String?
  resultText        String?       @db.Text
  source            String        @default("generated") // generated | replace
  sourceIntentRowId String? // 资金锚（=GenerationIntent.id）
  sourceExecSeq     BigInt?
  artifactIndex     Int           @default(0)
  state             ArtifactState @default(none)
  rev               Int           @default(0) // PG 权威版本——finalize/replace/clear CAS 锚
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([projectId, nodeId, role, targetField, targetItemId]) // 槽位唯一
  @@unique([sourceIntentRowId, sourceExecSeq, artifactIndex]) // 资金 finalize 幂等
  @@index([mediaId])
  @@index([teamId, state])
}

/// v11——DocDelivery 改造为投影 outbox（六终态；lease 覆盖 flush+recheck+mark；artifactRev=投影时快照）
model ArtifactProjection {
  id            String          @id @default(cuid())
  artifactId    String
  artifactRev   Int // 投影时快照——recheck 比对 NodeArtifact.rev
  projectId     String
  nodeId        String
  targetField   String // CHECK 白名单（fileId|result）
  targetItemId  String          @default("")
  mediaId       String?
  resultText    String?
  state         ProjectionState @default(pending)
  attempts      Int             @default(0)
  leaseUntil    DateTime?
  runId         String?
  nextAttemptAt DateTime        @default(now())
  lastError     String?         @db.VarChar(512)
  createdAt     DateTime        @default(now())
  projectedAt   DateTime?

  @@unique([artifactId, artifactRev])
  @@index([state, nextAttemptAt])
  @@index([artifactId])
}

/// v11——doc 引用索引（current-state upsert：同槽位换 media 即改行；惰性 reconcile 维护）
model MediaBinding {
  id           String   @id @default(cuid())
  mediaId      String
  projectId    String
  nodeId       String
  teamId       String
  role         String   @default("primary")
  targetField  String   @default("fileId") // CHECK 白名单（fileId|referenceImage|images|allImages|trimmedFileId|videoFileId|audioFileId）
  targetItemId String   @default("") // 非空 sentinel（PG NULL 不去重根修）
  createdAt    DateTime @default(now())
  media        Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([projectId, nodeId, role, targetField, targetItemId]) // 槽位唯一（current-state upsert）
  @@index([mediaId])
  @@index([projectId, nodeId])
}

/// v11——媒体事实 outbox（Z1''-v13b：替换 probedAt watermark；at-least-once+客户端 factVersion 幂等去重）。
/// 写入点三处（probe done/server natural/processing 态创建）与 Media.factVersion+1 同事务；来源=union(Media.projectId,binding.projectId)。
model MediaFactOutbox {
  id            String         @id @default(cuid())
  mediaId       String
  projectId     String
  factVersion   BigInt // 对应 Media.factVersion 快照（单调）；wire/doc 用 string——JSON 序列化=T6 收紧：DTO/响应构造处显式 String()（禁全局 BigInt.prototype.toJSON，同 Media.factVersion）
  factType      String // 事实类型（如 state——payload 含 state 的状态事实）
  payload       Json // 事实快照
  state         MediaFactState @default(pending)
  attempts      Int            @default(0)
  leaseUntil    DateTime? // emitter claim 崩溃恢复（FOR UPDATE SKIP LOCKED 行锁外的兜底）
  nextAttemptAt DateTime       @default(now()) // 失败退避（jitter）
  lastError     String?        @db.VarChar(512)
  createdAt     DateTime       @default(now())
  publishedAt   DateTime? // published retention 7d 清理判据

  @@unique([mediaId, projectId, factType, factVersion]) // factType 入键（S0.1 2026-10-20）——同 factVersion 下 natural/state 两类事实并存互不撞（T7/T16 前置）
  @@index([state, nextAttemptAt]) // claim 扫描（state='pending'∧nextAttemptAt<=now）；claim 排序契约=ORDER BY nextAttemptAt, createdAt, id（id 为 cuid opaque 非插入序——仅末位 tie-break，禁作代际/时序依据；T7/T16 emitter 按此实现）
  @@index([mediaId]) // REST POST（≤200 mediaIds）全量拉
}
