model CanvasDoc {
  projectId     String        @id
  project       CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state         Bytes
  stateSeq      BigInt        @default(0)
  // Y0b-4 T9a（Q-U v6）：vacuum 文档代际替换——generation=真空代数（装载播种 docGeneration
  // Map→doc-status 顶层 generation 产生；vacuum ⑥ 单事务 n+1）；preVacuumSv=真空前 doc 的
  // stateVector（beforeSync SyncStep1 SV 重叠检测代际门的 DB 权威源——重启不失效）。
  generation    Int           @default(0)
  preVacuumSv   Bytes?
  // Y1b T2（Z9''-v14）：doc schema 版本移 PG 列承载（meta.schemaVersion 删除——客户端无从篡改）；
  // 裁定2：@default(3)=Y1c 本批固定值（存量建行走默认——docShape v3 即当前代）
  schemaVersion Int           @default(3)
  updatedAt     DateTime      @updatedAt
}

