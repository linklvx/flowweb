  seq       BigInt
  update    Bytes
  createdAt DateTime      @default(now())
  project   CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, seq])
}

// Y0a-1：单实例租约行（Y0a-3 T2 起消费：expiresAt/renewedAt 用 timestamptz(3)——Z19/P2）
model CollabLease {
