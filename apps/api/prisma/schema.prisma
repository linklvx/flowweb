enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamStatus {
  ACTIVE
  DISBANDED
  DISBANDING // C1-0（R17）：team 维擦除进行态（team-scope erasure run 期间——app 写路径 fenceTeam 拒绝；迁移笔一 ALTER TYPE 置末）
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeamCreditTransactionType {
  recharge
  subscription_grant
  expire_clear
  register_grant
  upgrade_clear
  admin_grant
  admin_clear
  release // Y0b-1 预占释放——reversesId 指向被释放 reserve 行（1:1 配对，取消/失败回冲）
  refund // F13 退款逆向记账——reconcile 三查② VOIDED 事务专用
  reserve // 批0.5-9 两阶段扣费——外呼前冻结（amount 负=冻结/正=void 解冻反向）
  settle // 批0.5-9 冻结转实扣正账（外呼成功后补记，终态消费语义）
}

enum TeamSubscriptionStatus {
  active
  expired
}

enum TeamOrderStatus {
  PENDING
  SUCCESS
  CLOSED
}

enum RechargeKind {
  credits
  subscription
}

model Team {
