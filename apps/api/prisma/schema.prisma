model CanvasDoc {
  projectId          String        @id
  project            CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // ── 旧平面（Y0a-3/Y0b-4 形态）——Y1c T7 勘误（方案 B）：state/stateSeq 已随 T11（compact 重写+
  // 快照权威切换=CanvasDocSnapshot+currentSnapshotRev 指针）退役删除；preVacuumSv 已随 T12（SV 代际
  // 门退役——世代执法改道 docName 段 auth/load 双校验，迁移 20261024160000）退役删除；
  // schemaVersion @default(3) 默认移除→T9/T10 旧列拆除切片。
  // Y0b-4 T9a（Q-U v6）/Y1c T12：vacuum 文档代际替换——generation=真空代数（真值链：装载/boot 恒
  // 播种当代真值→docGeneration/doc-status 顶层 generation/canonical wire 名 #g 段三消费面；
  // vacuum ⑥ 单事务 n+1——新 docName(#g) 换代通道）。
  generation         Int           @default(0)
  // Y1b T2（Z9''-v14）：doc schema 版本移 PG 列承载（meta.schemaVersion 删除——客户端无从篡改）；
  // 裁定2：@default(3)=Y1c 本批固定值（存量建行走默认——docShape v3 即当前代）
  schemaVersion      Int           @default(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
  // ── Y1c T7（方案 B 增量）：v1.7 载体头行新列（spec §4.4/§5.1 水位拆义+§6.6 行级关闸）──
  // vacuumEpoch：压缩操作代次（遥测——无行为分支）；currentSnapshotRev：当前快照指针（compact 发布推进）
  vacuumEpoch        Int           @default(0)
  currentSnapshotRev BigInt        @default(0)
  // walCheckpointSeq（v1.7 拆义）：批提交时刻 spoolHeadSeq 采样（T10 写入方）——永不与 appliedSeq
  // 比较；同行 raw CHECK pgSeq≤walCheckpointSeq（Y1c T7 迁移一）
  walCheckpointSeq   BigInt        @default(0)
  // pgSeq：最后 PG 提交的 walSeq——对外唯一「已保存」水位（T10 起由批提交 CAS 推进）
  pgSeq              BigInt        @default(0)
  // purgeBelowSeq：WAL 清理水位（T11 compact 指针短事务持久——null=从未清理）
  purgeBelowSeq      BigInt?
  // maintenanceId：行级关闸（§6.6 REQUESTED 同事务写入+执行受理读 IS NULL 放行）——stage 单源在
  // MaintenanceOperation；无 FK 无 @@unique（唯一性=活跃维护 partial unique，非 CanvasDoc 责任）
  maintenanceId      String?
  // ── C3a-2（spec 2026-11-11-foundation-batch-design.md §0 水位不变量/§3.2-6）：binding 投影水位两列 ──
  // mediaBindingSeq=连续投影前缀（dirty 期间任何增量成功不得推进；仅全量 rebuild CAS 清 dirty 并推
  // 水位——恒 mediaBindingSeq<=pgSeq；推进/回填消费归 C3a-4/6/8）；bindingsDirty=脏标记（SAVEPOINT
  // 回滚/恢复四路置位；**迁移内 UPDATE 既有项目全置 true——修 0==0 假覆盖，第七轮 P0-5**，新建行走
  // schema 默认 false、genesis 同事务置 dirty 归 C3a-6）。BigInt 默认 @default(0)（非 0n——§纪律）。
  mediaBindingSeq    BigInt        @default(0)
  bindingsDirty      Boolean       @default(false)
}

enum ProjectRole {
  PROJECT_OWNER
  PROJECT_EDITOR
  PROJECT_VIEWER
}

// ══════ Y1c T7（方案 B 增量——2026-10-24 勘误落定）：v1.7 载体族新对象 ══════
// spec §4.4/§5.1/§6（2026-10-23-y1c-doc-model-carrier-contract-design.md）；冻结契约=
// packages/shared/src/collab/{runtime-event,maintenance,system-history,doc-protocol}.ts。
// 纪律：BigInt 默认 @default(0)（非 0n）；JSON 面 BigInt 恒十进制字符串（system-history.ts 契约）。

/// SystemHistory 全局单行唯一权威（spec §4.4⑦——删 CanvasDoc.historyId 列语义：restore 恒整库恢复）。
/// bump 单事务（更新本行+trigger 同步缓存）提交后才允许启动；启动任一不匹配/缺失/为零=fail-closed
/// 不自动修复（禁 --adopt-wal 窄窗外自动建行）。raw SQL：CHECK (id = 1)（Prisma 无法表达单行约束——
/// Controller 裁定 1）；引导行=迁移内 INSERT id=1（安装语义非运行时自动修复——Controller 裁定 3）。
model SystemHistory {
  id             Int      @id @default(1)
  historyId      String
  epochStartedAt DateTime @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

/// RuntimeFeedCursor 专用计数行（spec §7 D5 per-project feedSeq——表名无 @@map：与 T5b 冻结
/// RUNTIME_FEED_CURSOR_UPSERT_SQL 的 "RuntimeFeedCursor" 表名一致〔Controller 裁定 2〕）。
/// upsert ON CONFLICT=唯一取号路径；genesis 建项目同事务插行；锁序=业务行→counter（counter 恒最后拿）。
/// 无 Prisma relation（卡文表形如此——feed 平面计数行不挂 Cascade FK；项目删除清理归 T29 reset 工具域）。
model RuntimeFeedCursor {
  projectId      String @id
  lastSeq        BigInt @default(0)
  minRetainedSeq BigInt @default(0)
}

/// CanvasDocSnapshot 快照行（spec §4.5——快照只从 PG 前缀生成且只到 pgSeq）。
/// 跨表不变量 Snapshot.stateSeq≤pgSeq 非 CHECK——由快照发布事务行锁+条件更新保证（T11 落地）。
/// raw SQL：CHECK (octet_length(state) <= 16MiB)。
model CanvasDocSnapshot {
  projectId     String
  generation    Int
  snapshotRev   BigInt
  stateSeq      BigInt
  state         Bytes
  /// SHA-256 hex（64 字符）——genesis=建头种子字节哈希；compact 发布=前缀重放态哈希（T11）
  stateHash     String   @db.Char(64)
  vacuumEpoch   Int
  schemaVersion Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, generation, snapshotRev])
}

/// DocAuditEvent 敏感操作同 PG 事务审计（spec §6.4 注记——180d 保留，清理 worker 归 T29）。
/// kind 词表单源=shared DOC_AUDIT_KINDS（delete/execute/permission/maintenance/refund）；
/// payload 不含正文（PII 扫描纪律同 RuntimeEvent）。写入方=T21/T27（本卡只落表）。
model DocAuditEvent {
  id        String  @id
  projectId String
  kind      String
  userId    String
  requestId String?
  payload   Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([projectId, createdAt])
}

/// MaintenanceOperation 维护窗口载体（spec §6.6——stage 单源在本表；CanvasDoc 不存 stage 副本）。
/// stage 11 值=shared MAINTENANCE_STAGES 冻结（防漂移锚=api 侧 setEqual 测试——Prisma enum 无法
/// import shared 常量，用测试锚定单源）；status=String（T5b 冻结 MaintenanceOperationRow.status:string
/// 即如此——卡文 enum 记号无值集出处，值域待 T27 消费方定，届时如需 enum 随其迁移收紧）。
/// raw SQL：活跃维护 partial unique（一项目一活跃——stage NOT IN 三终态）。
model MaintenanceOperation {
  maintenanceId    String           @id
  projectId        String
  stage            MaintenanceStage
  status           String
  attempt          Int              @default(0)
  sourceGeneration Int
  targetGeneration Int
  schemaVersion    Int
  cutoffPgSeq      BigInt
  drainedAt        DateTime?        @db.Timestamptz(3)
  error            String?
  idempotencyKey   String           @unique
  leaseOwner       String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  @@index([projectId, status])
}

/// 9 主段+2 终态（11 值）——逐字对照 shared MAINTENANCE_STAGES（maintenance.ts T5b 冻结）：
/// REQUESTED→FREEZING→DRAINING→DRAINED→EXPORTING→REBUILDING→SWITCHING→VERIFYING→COMPLETED
/// +FAILED/ABORTED（SWITCHING=唯一不可回退点）
enum MaintenanceStage {
  REQUESTED
  FREEZING
  DRAINING
  DRAINED
  EXPORTING
  REBUILDING
  SWITCHING
  VERIFYING
  COMPLETED
  FAILED
  ABORTED
}

// ══════ Y1c T21（迁移二——20261025120000）：P3 业务族 DDL（spec §6.1/§6.2/§6.5/§7 v5.4）══════
// 冻结契约单源=packages/shared/src/collab/{execution-request,execution-chain,runtime-event,lifecycle}.ts
// （T5b 冻结 exact DDL——本块=Prisma 落地形态）。RuntimeFeedCursor=T7 已建（复用勿重建）。
// 纪律：BigInt 默认 @default(0)；JSON/wire 面 BigInt 恒十进制字符串（system-history.ts 契约）；
// 无 FK relation（DocAuditEvent/MaintenanceOperation 先例——业务平面纯列，项目删除清理归 T29）。
// #4 族分离：execSeq=执行代际族（NodeExecution 更新守卫/GenerationIntent/RefundObligation）；
// lifecycleSeq/fenceSeq=生命周期族（NodeLifecycle/DeliveryFence）——两族序永不互换互指。

/// ExecutionRequest 父行（每请求一行——spec §6.1）。id=内部主键 cuid（客户端字符串禁作全局 PK）；
/// requestId=客户端幂等键（项目内唯一）；historyId=PITR 后同 requestId 重试不匹配→409 REQUEST_STALE；
/// docSeq=客户端下界（save barrier 回执 committedSeq）；frozenDocSeq=服务端实际冻结值（>=docSeq）；
/// state 值域（T21）=ADMITTED/EXECUTING/COMPLETED/FAILED/VOIDED（终态扫描+sweeper 消费）。
model ExecutionRequest {
  id             String   @id @default(cuid())
  requestId      String
  projectId      String
  generation     Int
  historyId      String
  docSeq         BigInt
  frozenDocSeq   BigInt
  userId         String
  teamId         String
  kind           String
  state          String   @default("ADMITTED")
  reservedCredit Int      @default(0)
  totalCredit    Int      @default(0)
  planHash       String   @db.Char(64)
  inputHash      String   @db.Char(64)
  expiresAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@unique([projectId, requestId])
  @@index([projectId, state, expiresAt])
  @@index([teamId, state]) // C1-0：retention stuck 扫（ADMITTED/EXECUTING∧expiresAt）+team 资金域扫（C4 扩查接线）
}

/// ExecutionNodePlan 子行（每节点一行——claim/retry/退款/artifact 关系性载体）。
/// requestId 列=父行 ExecutionRequest.id（内部主键 join 键——T5b 缩写「requestId」落地澄清：
/// 客户端幂等键住父行 requestId 列）。scopeNodeIds 不落列——从本表派生；planHash 只盖不可变
/// 字段（PLAN_HASH_IMMUTABLE_FIELDS——status/execSeq/generationIntentId 不进）。
model ExecutionNodePlan {
  requestId          String
  nodeId             String
  order              Int
  type               String
  model              String?
  resolution         String?
  styleId            String?
  pricingRuleId      String?
  creditCost         Int     @default(0)
  reservedCredit     Int     @default(0)
  paramsHash         String  @db.Char(64)
  status             String  @default("PENDING")
  generationIntentId String?
  execSeq            BigInt?

  @@id([requestId, nodeId])
  @@index([requestId, order])
}

/// ExecutionInput 冻结输入（PG Bytes/TOAST——不引对象存储依赖）。encoding=json+gzip|json+brotli
/// （node:zlib——禁 zstd）；content=压缩字节（stored≤2MiB ∧ raw≤8MiB 任一超限 413 不截断）；
/// contentHash=SHA-256(content) hex64（inputHash=contentHash 单源）；expiresAt 必填（终态 30d 清理）。
model ExecutionInput {
  requestId     String   @id
  encoding      String
  content       Bytes
  contentHash   String   @db.Char(64)
  rawBytes      Int
  storedBytes   Int
  schemaVersion Int
  expiresAt     DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt]) // C1-0：retention 过期扫（终态 30d 清理 worker——ExecutionRequestRetentionService 消费）
}

/// RuntimeEvent（spec §7——per-project feedSeq 连续跨代不重置；@@unique([projectId,feedSeq])）。
/// kind 词表单源=shared EVENT_KINDS（runtime-event.ts）；payload v:1+≤64KB+PII 扫描（写入方=T22/T26）。
/// feedSeq 分配=RuntimeFeedCursor upsert 行锁（RUNTIME_FEED_CURSOR_UPSERT_SQL 单源——T22 消费）。
model RuntimeEvent {
  id         String   @id @default(cuid())
  projectId  String
  generation Int
  feedSeq    BigInt
  kind       String
  payload    Json
  docSeq     BigInt?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, feedSeq])
  @@index([projectId, generation, feedSeq])
  @@index([projectId, createdAt]) // C1-0：retention 7d 过期扫（先到为准 100k 同判——C1 worker 消费）
}

/// NodeExecution 当前行表（spec §6.2——PK(projectId,nodeId)；历史留 GenerationIntent）。
/// 更新守卫=generation 匹配且 execSeq 严格单调（shared nodeExecutionUpdateAllowed 单源→PG CAS
/// WHERE generation=? AND execSeq<?——旧 worker 迟到更新拒绝）；nodeVersion=该节点末次事件 feedSeq。
/// #4：execSeq=执行代际族（≠lifecycleSeq 生命周期族——lifecycle.ts）。
model NodeExecution {
  projectId   String
  nodeId      String
  generation  Int
  execSeq     BigInt
  nodeVersion BigInt   @default(0)
  status      String
  attempts    Int      @default(1)
  errorCode   String?
  artifactRev Int?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@id([projectId, nodeId])
}

/// ExecutionOutbox 工作队列（spec §6.2——**禁作 feed 日志**：可 claim/可更新/可删会使 feed 游标出洞；
/// feed=RuntimeEvent）。唯一键含 generation+业务幂等键 businessKey；SKIP LOCKED 租约 claim。
model ExecutionOutbox {
  id           String   @id @default(cuid())
  projectId    String
  generation   Int
  businessKey  String
  kind         String
  payload      Json?
  state        String   @default("PENDING")
  claimOwner   String?
  claimUntilMs BigInt?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([projectId, generation, businessKey])
  @@index([projectId, state, claimUntilMs])
}

/// MaterializeRun（spec §6.3——materializeRunId+expectedExecSeq 双锚 fencing）。
/// Y1c T23 定形：state 值域=RUNNING→COMPLETED|FAILED|FENCED（终态；claim 建行 RUNNING，
/// 完成/终态失败/lease 失守写回带 runId+state=RUNNING CAS——旧 run 迟到写 0 命中=让位，
/// 兑现「materializeRunId/expectedExecSeq fencing」（B12/B17 继承——与 Media.processingLeaseUntil
/// 值 CAS 双闸，run 行=durable 侧记录）。expectedExecSeq=Media.sourceExecSeq（执行代际族——
/// #4：与 lifecycleSeq/fenceSeq 生命周期族无关）。
model MaterializeRun {
  id              String   @id @default(cuid())
  projectId       String
  nodeId          String
  expectedExecSeq BigInt
  state           String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([projectId, state])
}

/// RefundObligation（spec §6.3——unique(intentRowId,execSeq)+reversesId 幂等：exact settle row 逆转；
/// 不依据客户端 doc 字段或过期 worker 状态）。#11 退款路径：EXEC_FINALIZE 义务收口链消费（T26 生成面
/// /T23 sweeper 消费面——迟到旧义务（pinned execSeq）对换代行 0 命中=让位零资金动作）。
model RefundObligation {
  id           String   @id @default(cuid())
  intentRowId  String
  execSeq      BigInt
  reversesId   String
  creditAmount Int
  state        String   @default("PENDING")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([intentRowId, execSeq])
}

/// StorageReservation（spec §6.3 资源回收——上传配额预留状态机；Y1c T23 迁移三）：
/// presign 受理同事务建行（upperBoundBytes 必填——无上界 fail-closed 拒受理）；配额硬门
/// （assertCanUpload/assertOnConfirm）计 ACTIVE 预留（Q7「两并发 presign 同过」收口）；
/// 终态释放=锚 pending Media 行终态迁移同事务（confirm→SETTLED 实字节入账/取消·TTL·拒→RELEASED）
/// ——**lease（pendingExpiresAt）过期不独立释放**：释放必与锚行离开 pending 原子同发
/// （迟到 confirm 被 status='pending' CAS 拒 409）=在飞上传无 oversale 窗。
/// 生成产物链（registerInTx 资金软限形态）不建预留——quota=软限裁决（v10 裁决④）维持。
model StorageReservation {
  id              String   @id @default(cuid())
  teamId          String
  mediaId         String   @unique
  upperBoundBytes BigInt
  state           String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@index([teamId, state])
}

/// ObjectManifest（spec §6.3——对象登记+delete-claim；Y1c T23 迁移三）：claimOwner/claimUntil
/// 在位未过=**GC 禁删**（在飞上传/物化键保护——T19 登记 Y2「GC 变体枚举误删在飞对象」收口机制：
/// 物化链上传 content-addressed 键前 claim、锚定〔Media.key 引用/事务提交〕后 release）；
/// 有界 orphan=manifest 行域内清扫（claim 已过期∧无 Media.key 引用∧行龄过界——无全桶枚举）。
model ObjectManifest {
  id         String   @id @default(cuid())
  objectKey  String   @unique
  sizeBytes  BigInt   @default(0)
  claimOwner String?
  claimUntil BigInt?
  state      String   @default("LIVE")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([state, claimUntil])
}

/// NodeLifecycle（spec §6.5——服务端只读观察产物；lifecycleSeq=per-project 单调数值序；
/// 当前行 partial unique=迁移 raw SQL UNIQUE(projectId,nodeId) WHERE is_current——历史行保留）。
/// #4：lifecycleSeq=生命周期族（≠execSeq 执行代际族）。义务可从帧前缀确定性重建（T26）。
model NodeLifecycle {
  projectId    String
  nodeId       String
  lifecycleSeq BigInt
  isCurrent    Boolean  @default(true)
  state        String
  walSeq       BigInt
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@id([projectId, nodeId, lifecycleSeq])
  @@index([projectId, nodeId, isCurrent])
}

/// DeliveryFence（spec §6.5——交付事务写 artifact 前的 fence 校验载体：fenceSeq==当前 lifecycleSeq
/// 且 state=ACTIVE——不匹配=丢弃不退款；T26 观察器维护 delete/restore+当前态）。
model DeliveryFence {
  projectId String
  nodeId    String
  fenceSeq  BigInt
  state     String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([projectId, nodeId])
}

/// LifecycleObligation 义务队列（#11——T21 定队列落地：state/attempts/lease 执行面+lifecycle.ts
/// 生成面同表承载；kind 词表单源=OBLIGATION_KINDS〔FEED_TOMBSTONE/NODE_DELETED/EXEC_FINALIZE〕；
/// 队列转移单源=shared nextObligationQueueState；SKIP LOCKED 租约+attempts 上限 5→DEAD fail-closed）。
model LifecycleObligation {
  id           String   @id @default(cuid())
  projectId    String
  nodeId       String
  kind         String
  walSeq       BigInt
  state        String   @default("PENDING")
  attempts     Int      @default(0)
  claimOwner   String?
  claimUntilMs BigInt?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([projectId, nodeId, kind, walSeq])
  @@index([projectId, state, claimUntilMs])
}

model ProjectMember {
  id        String        @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  project   CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// Y1c T9（Controller 裁定 1——T7 勘误既定切片）：写入方换代——spool-first actor 批行形态。
// seq=批 lastWalSeq（walSeq 单调——T8 WAL 帧协议）；updateHash=有序 frameHash 列表 SHA-256
// （非 merged update 字节——重试/重组批幂等）；actorRanges 本卡先落空 Json（T5b 冻结 system-history
// 形态约束住类型——T10/T22 补齐面，如实登记）。
// raw SQL（迁移段附注，Prisma 不可表达）：CHECK (octet_length(update) <= 16MiB)
// +CHECK (seq >= firstWalSeq)+CHECK (frameCount > 0)——不存单 frameId（偏离 33）。
model CanvasDocUpdate {
  projectId   String
  generation  Int
  seq         BigInt
  firstWalSeq BigInt
  frameCount  Int
  updateHash  String        @db.Char(64)
  actorRanges Json?
  update      Bytes
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  project     CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, generation, seq])
  @@unique([projectId, generation, updateHash])
}

/// C1-0（迁移笔一——C3 表列一次到位）：T30b 同内容幂等吞行记录侧表（appendBatch ON CONFLICT 吞行
/// 的行间衔接断点载体——seq=被吞帧行、sourceSeq=在档同 updateHash 行 seq、reason='t30b-coalesced'）。
/// 纯列业务平面无 FK relation（DocAuditEvent 先例）；接线归 C3（同事务 INSERT ON CONFLICT DO NOTHING 幂等）；
/// 生命周期随 CanvasDocUpdate：purgeBelow 顺带删侧表行+擦除随 scope 批删（C3 兼容核验单测钉死）。
model CanvasDocCoalesced {
  projectId  String
  generation Int
  seq        BigInt
  updateHash String   @db.Char(64)
  sourceSeq  BigInt
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([projectId, generation, seq])
  @@index([projectId, generation, updateHash])
}

// Y0a-1：单实例租约行（Y0a-3 T2 起消费：expiresAt/renewedAt 用 timestamptz(3)——Z19/P2）
model CollabLease {
  scope     String    @id
  owner     String?
  epoch     BigInt    @default(0)
  expiresAt DateTime? @db.Timestamptz(3)
  renewedAt DateTime? @db.Timestamptz(3)
}

